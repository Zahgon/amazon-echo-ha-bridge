{
  "name": "amazon-echo-bridge",
  "version": "0.4.0",
  "description": "Emulates a Philips Hue bridge to allow the Amazon Echo to integrate seamlessly into various home automation systems.",
  "repository": "https://github.com/armzilla/amazon-echo-ha-bridge",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "bin": {
    "amazon-echo-bridge": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "resources/**/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
